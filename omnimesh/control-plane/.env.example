AGENT_TOKEN=change-me-to-a-real-secret

# How long POST /v1/chat/completions waits for a node to finish a job
# before returning 504 (ms). The job itself isn't lost on timeout - it
# can still complete and show up via GET /jobs/:id.
# CHAT_JOB_TIMEOUT_MS=600000

# Node health sweep: how often the hub checks for stale nodes (ms), and
# how long since last_seen_at before a node is marked "degraded" (idle,
# no job assigned) or "dead" (no contact regardless of job state). Keep
# NODE_DEAD_AFTER_MS comfortably above CHAT_JOB_TIMEOUT_MS - a busy node
# doesn't poll while running a job.
# HEALTH_CHECK_INTERVAL_MS=30000
# NODE_DEGRADED_AFTER_MS=60000
# NODE_DEAD_AFTER_MS=900000
